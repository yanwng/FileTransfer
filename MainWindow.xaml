<Window x:Class="FileTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileTransfer"
        mc:Ignorable="d"
        xmlns:cm="clr-namespace:FileTransfer.command"
        xmlns:cv="clr-namespace:FileTransfer.conveter"
        Title="MainWindow" Height="450" Width="800"
        MinHeight="450" MinWidth="800"
        MouseDown="Window_MouseDown"
        WindowStartupLocation="CenterScreen"
        >

    <Window.Resources>
        <cv:VisibilityConveter x:Key="visibilityConveter"></cv:VisibilityConveter>
        <!--<ResourceDictionary x:Key="radioButton" Source="/style/RadioButtonStyle.xaml"/>-->
        <cv:IsCheckedConverter x:Key="isCheckedConverter"/>
    </Window.Resources>

    
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="200" MaxWidth="500"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="10*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <!--菜单栏-->
        <Border Grid.Column="0"  Padding="2">
            <Grid Background="#9FFFFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <RadioButton  Background="{Binding RelativeSource={RelativeSource Mode=Self},Path=IsChecked, Converter={StaticResource isCheckedConverter}}"
                    x:Name="fileTransfer" FontSize="25" Grid.Row="0"  IsChecked="True" Content="文件传输">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Background="{TemplateBinding Background}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"></ColumnDefinition>
                                        <ColumnDefinition Width="10*" ></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <Image Source="/assert/文件传输.png" Width="50" Margin="5"></Image>

                                    <ContentPresenter Grid.Column="1" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Left"></ContentPresenter>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </RadioButton.Template>

                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="White"></Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>

                </RadioButton>
                <RadioButton   Background="{Binding RelativeSource={RelativeSource Mode=Self},Path=IsChecked, Converter={StaticResource isCheckedConverter}}" 
                               FontSize="25"  x:Name="settings" Grid.Row="1" Content="设置" >

                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Background="{TemplateBinding Background}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*"></ColumnDefinition>
                                        <ColumnDefinition Width="10*" ></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <Image Source="/assert/设置.png" Width="50" Margin="5"></Image>

                                    <ContentPresenter Grid.Column="1" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Left"></ContentPresenter>
                                </Grid>
                            </Border>

                        </ControlTemplate>
                        
                    </RadioButton.Template>

                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="White"></Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                    
                </RadioButton>
            </Grid>
        </Border>

        <!--分割条-->
        <GridSplitter Grid.Column="1"  Width="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="SkyBlue"
                      >
            
        </GridSplitter>

        <Grid Grid.Column="2"  >
            <!--文件传输界面-->
            <Border Padding="2">
                <Grid Background="#C6D6E5" Visibility="{Binding ElementName=fileTransfer, Path=IsChecked, Converter={StaticResource visibilityConveter}, Mode=TwoWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="5"></RowDefinition>
                    </Grid.RowDefinitions>
                
                    <Rectangle x:Name="ConnectRect" Fill="Red" Height="30" Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}, Path=ActualWidth}"></Rectangle>
                    <TextBlock x:Name="ConnectText" MouseDown="CreateConnection" TextAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="22">未连接</TextBlock>
                    <Border Grid.Row="1">
                        <ListView Background="#C6D6E5" x:Name="ls" ItemsSource="{Binding Files}">
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="ListViewItem">
                                    <Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FileName}"/>
                                            <TextBlock Margin="10,0" Text="{Binding IsSucess}"/>
                                            <TextBlock Text="{Binding SendSucess}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>
                    </Border>

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10*"></ColumnDefinition>
                            <ColumnDefinition Width="1*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="selectFileBox" MouseDown="SelectFile" Grid.Column="0" 
                                   FontSize="30" Foreground="DeepPink" TextAlignment="Center" VerticalAlignment="Center">点击选择文件</TextBlock>
                        <Button Grid.Column="1" Click="SendFileConfirm">发送</Button>
                    </Grid>

                    <ProgressBar Grid.Row="3" x:Name="prog" Visibility="Collapsed"/>
                </Grid>
            </Border>


            <!--设置界面-->
            <Border Padding="2" >
                <Grid Background="#C6D6E5"  Visibility="{Binding ElementName=settings, Path=IsChecked, Converter={StaticResource visibilityConveter}, Mode=TwoWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>



                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock>文件保存路径：</TextBlock>
                        <TextBlock Margin="10,0" Text="{Binding DownLoadFolderPath}"></TextBlock>
                        <Button Click="ChangeDownLoadPlace">更改</Button>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>
        
    </Grid>
</Window>
